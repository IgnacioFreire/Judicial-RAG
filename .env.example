# LLM provider — uncomment the one you want to use
DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Active LLM provider: "anthropic", "openai", "gemini" or "deepseek"
LLM_PROVIDER=deepseek

# LLM model to use
LLM_MODEL=deepseek-reasoner

# Embeddings — Hugging Face Inference API
# Same key as your HF Spaces deployment
HUGGINGFACE_API_KEY=hf_...

# Embedding provider (currently only "huggingface" is supported)
EMBEDDING_PROVIDER=huggingface

# Embedding model — best open-source multilingual retrieval model for Spanish
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Maximum number of PDFs processed in parallel
MAX_PARALLEL_PDFS=4

# Maximum session duration in minutes before temporary files are cleaned up
SESSION_TIMEOUT_MINUTES=60

# PDF notebook. Copy this file to .env and fill these in there.
# .env is gitignored. Do not put your email or password in a committed file.
# Use the anon key. Do not put the service role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_PASSWORD=
SUPABASE_PDF_BUCKET=pdfs